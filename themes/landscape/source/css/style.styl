@import "nib"
@import "_variables"
@import "_util/mixin"
@import "_util/grid"

global-reset()

 /* === =========================== === */

.back-btn
  display inline-block
  margin-top 1rem
  font-family 'Staatliches', sans-serif
  font-size 1.2rem
  color var(--accent)
  transition letter-spacing 0.2s ease

.back-btn:hover
  letter-spacing 1px

body
  font-family 'Poppins', sans-serif
  background #fafafa
  color #222
  line-height 1.6

h1, h2, h3, h4
  font-family 'Staatliches', sans-serif
  letter-spacing 1px
  margin-bottom 1rem

  /* === Post Card Styling === */

.post
  background white
  padding 2rem
  border-radius 16px
  box-shadow 0 4px 20px rgba(0,0,0,0.08)
  margin-bottom 2rem
  transition transform 0.2s ease, box-shadow 0.2s ease

.post:hover
  transform scale(1.02)
  box-shadow 0 6px 24px rgba(0,0,0,0.12)

  /* === Index Cards === */

.post-card
  background white
  padding 1.5rem
  border-radius 16px
  box-shadow 0 4px 20px rgba(0,0,0,0.08)
  margin-top 2rem
  transition transform 0.2s ease

.post-card:hover
  transform scale(1.02)

  /* === Link Hover Animation === */

a
  color #000 !important
  font-weight 600
  transition letter-spacing 0.2s ease, color 0.2s ease
  text-decoration none

a:hover
  letter-spacing 1px
  color var(--accent)

.back-btn
  display inline-block
  margin-top 1rem
  font-family 'Staatliches', sans-serif
  font-size 1.2rem
  color var(--accent)
  transition letter-spacing 0.2s ease

.back-btn:hover
  letter-spacing 1px

.widget
  border-radius 10px
 /* === =========================== === */

input, button
  margin: 0
  padding: 0
  &::-moz-focus-inner
    border: 0
    padding: 0

html, body, #container
  height: 100%

body
  background: color-background
  font: font-size font-sans
  -webkit-text-size-adjust: 100%

.outer
  clearfix()
  max-width: (column-width + gutter-width) * columns + gutter-width
  margin: 0 auto
  padding: 0 gutter-width

.inner
  column(columns)

.left, .alignleft
  float: left

.right, .alignright
  float: right

.clear
  clear: both

#container
  position: relative

.mobile-nav-on
  overflow: hidden

#wrap
  height: 100%
  width: 100%
  position: absolute
  top: 0
  left: 0
  transition: 0.2s ease-out
  z-index: 1
  background: color-background
  .mobile-nav-on &
    left: mobile-nav-width

if sidebar and sidebar isnt bottom
  #main
    @media mq-normal
      column(main-column)

if sidebar is left
  @media mq-normal
    #main
      float: right

@import "_extend"
@import "_partial/header"
@import "_partial/article"
@import "_partial/comment"
@import "_partial/archive"
@import "_partial/footer"
@import "_partial/highlight"
@import "_partial/mobile"

if sidebar
  @import "_partial/sidebar"