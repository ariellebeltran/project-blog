<% 
  // Convert posts to array and sort newest → oldest
  var posts = page.posts.toArray().sort(function(a, b) {
    return b.date - a.date;
  });
%>

<% posts.forEach(function(post){ %>
  <article class="post-card">
    <h2 class="post-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>

    <div class="post-excerpt">
      <%- post.excerpt %>
    </div>
  </article>
<% }) %>

<%- partial('pagination') %>
