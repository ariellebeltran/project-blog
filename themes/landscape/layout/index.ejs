<% page.posts.each(function(post){ %>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">
        <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      </h1>
    </header>

    <section class="post-excerpt">
      <%- post.excerpt %>
    </section>
  </article>
<% }) %>

<%- partial('pagination') %>
