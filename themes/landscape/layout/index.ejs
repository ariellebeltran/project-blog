<% 
  // Get all posts from the site (newest → oldest)
  var posts = site.posts.sort('-date');
%>

<% posts.forEach(function(post){ %>
  <article class="post-card">
    <h2 class="post-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>

    <div class="post-excerpt">
      <%- post.excerpt %>
    </div>
  </article>
<% }) %>
